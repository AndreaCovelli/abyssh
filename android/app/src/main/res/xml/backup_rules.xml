<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Nothing is backed up. Saved hosts, passwords, passphrases, and SSH keys leave the
         device only through Abyssh's encrypted export; trusted host keys, settings, and
         the local shell's home directory (shell history, ~/.ssh) are not backed up. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
