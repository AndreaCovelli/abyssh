#!/usr/bin/env bash
#MISE description="Tag the next version from the commits since the last release"
# Tag the next release from the Conventional Commits since the last vMAJOR.MINOR.PATCH tag.
#
# Before 1.0, a breaking change bumps the minor version and everything else bumps the
# patch version. From 1.0 on, breaking changes bump major, feat bumps minor, and
# everything else bumps patch. Pass major, minor, or patch to override the bump.
#
# The tag is created locally; push it to start the Release workflow.
set -euo pipefail

override="${1:-}"
case "$override" in
  "" | major | minor | patch) ;;
  *)
    echo "usage: mise run release [major|minor|patch]" >&2
    exit 2
    ;;
esac

if [ "$(git rev-parse --abbrev-ref HEAD)" != main ]; then
  echo "error: release from main" >&2
  exit 1
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "error: the working tree has uncommitted changes" >&2
  exit 1
fi

last="$(git tag --merged HEAD -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)"
if [ -z "$last" ]; then
  echo "error: no vMAJOR.MINOR.PATCH tag reachable from HEAD" >&2
  exit 1
fi
IFS=. read -r major minor patch <<<"${last#v}"

range="${last}..HEAD"
if [ "$(git rev-list --count "$range")" -eq 0 ]; then
  echo "error: no commits since $last" >&2
  exit 1
fi

bump="$override"
if [ -z "$bump" ]; then
  if git log --format='%s' "$range" | grep -qE '^[a-z]+(\([^)]*\))?!:' ||
    git log --format='%b' "$range" | grep -qE '^BREAKING[ -]CHANGE:'; then
    bump=$([ "$major" -eq 0 ] && echo minor || echo major)
  elif [ "$major" -gt 0 ] && git log --format='%s' "$range" | grep -qE '^feat(\([^)]*\))?:'; then
    bump=minor
  else
    bump=patch
  fi
fi

case "$bump" in
  major) next="$((major + 1)).0.0" ;;
  minor) next="${major}.$((minor + 1)).0" ;;
  patch) next="${major}.${minor}.$((patch + 1))" ;;
esac

echo "Commits since $last:"
git log --format='  %s (%h)' "$range"
echo
echo "$last -> v$next ($bump)"
git tag -a "v$next" -m "Abyssh $next"
echo "Created tag v$next. Push it to build the release: git push origin v$next"
